# Base de données Supabase (Postgres) — pooler Supavisor en mode session (port 5432).
# La connexion directe (db.<ref>.supabase.co) est IPv6-only sans l'add-on IPv4 Supabase ;
# le pooler est IPv4. Récupérer l'URL exacte : Supabase > Project Settings > Database >
# Connection pooling > Session mode.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Client Supabase (auth/storage éventuels côté API — non utilisés par Prisma)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Upload de fichiers (pièces jointes / étapes de mission) vers Supabase Storage.
# Clé "service_role" (Project Settings > API > service_role) — jamais exposée au
# client, jamais commitée. Le bucket est créé automatiquement au premier upload.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="pieces-jointes"

JWT_SECRET="change-me-generate-a-random-secret"
JWT_EXPIRES_IN="8h"
